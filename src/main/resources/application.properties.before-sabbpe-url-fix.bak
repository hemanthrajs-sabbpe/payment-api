spring.application.name=payment-api

# ===============================
# MariaDB Database Configuration
# ===============================

spring.datasource.url=jdbc:mariadb://localhost:3306/payment_db
spring.datasource.username=root
spring.datasource.password=SpringBoot@2026#DB

# ===============================
# JPA / Hibernate Configuration
# ===============================

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# ===============================
# Custom Payment Callback
# ===============================

payment.callback.secret=OUR_OWN_RANDOM_SECRET

# ===============================
# Easebuzz Sandbox Configuration
# Existing integration - preserved
# ===============================

easebuzz.key=ZF93ZSH6B
easebuzz.salt=2Y1MFHGIB
easebuzz.base-url=https://testpay.easebuzz.in

# ===============================
# SabbPe Pay By Link - UAT
# ===============================

# SabbPe base URL
sabbpe.base-url=https://ecosystemuat.sabbpe.com

# SabbPe API endpoints
sabbpe.token-path=/sabbpe/v1/token
sabbpe.initiate-path=/sabbpe/v1/paybylink/generate
sabbpe.decrypt-token-path=/api/v1/decrypt-token
sabbpe.status-path=/sabbpe/v1/paybylink/status

# SabbPe authentication credentials
sabbpe.merchant-id=SBPBLmer01
sabbpe.user-id=SBlopblmer01
sabbpe.password=PBLmer01@123456

# React frontend URL
sabbpe.frontend-url=${SABBPE_FRONTEND_URL:http://localhost:5173}

# Registered SabbPe merchant contact details
# Configure these environment variables before creating payments.
sabbpe.merchant-name=PBL SIAN
sabbpe.merchant-email=strangerock144@gmail.com
sabbpe.merchant-phone=9999999998

# ===============================
# Logging Configuration
# ===============================

logging.level.org.springframework.security=DEBUG
logging.level.org.springframework.web=DEBUG