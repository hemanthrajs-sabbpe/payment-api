package com.example.payment_api;

import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import com.fasterxml.jackson.annotation.JsonProperty;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpEntity;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestClientResponseException;
import org.springframework.web.client.RestTemplate;

import java.math.BigDecimal;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

@Service
public class SabbPeStatusService {

    @Value("${sabbpe.base-url}")
    private String baseUrl;

    @Value("${sabbpe.status-path}")
    private String statusPath;

    @Value("${sabbpe.merchant-id}")
    private String merchantId;

    private final RestTemplate restTemplate = new RestTemplate();

    public SabbPePaymentStatusResponse getPaymentStatus(
            String pblOrderRef) {

        // 1. Validate configuration.
        if (isBlank(baseUrl) || isBlank(statusPath)) {
            throw new IllegalStateException(
                    "SabbPe base URL and status path must be configured."
            );
        }

        if (isBlank(merchantId)) {
            throw new IllegalStateException(
                    "SabbPe merchant ID is missing."
            );
        }

        // 2. Validate the Pay By Link reference.
        if (isBlank(pblOrderRef)) {
            throw new IllegalArgumentException(
                    "Pay By Link reference is required."
            );
        }

        // 3. Prepare the SabbPe status request.
        Map<String, String> requestBody = new LinkedHashMap<>();

        requestBody.put(
                "pbl_order_ref",
                pblOrderRef.trim()
        );

        requestBody.put(
                "merchant_id",
                merchantId
        );

        HttpHeaders headers = new HttpHeaders();

        headers.setContentType(MediaType.APPLICATION_JSON);
        headers.setAccept(List.of(MediaType.APPLICATION_JSON));

        HttpEntity<Map<String, String>> request =
                new HttpEntity<>(requestBody, headers);

        // 4. Construct the status API URL.
        String url = baseUrl.replaceAll("/+$", "")
                + "/"
                + statusPath.replaceAll("^/+", "");

        try {

            // 5. Request the payment status directly from SabbPe.
            ResponseEntity<SabbPePaymentStatusResponse> response =
                    restTemplate.postForEntity(
                            url,
                            request,
                            SabbPePaymentStatusResponse.class
                    );

            SabbPePaymentStatusResponse result = response.getBody();

            // 6. Reject an empty response.
            if (result == null) {
                throw new IllegalStateException(
                        "SabbPe returned an empty payment-status response."
                );
            }

            // 7. Validate the gateway returned by SabbPe.
            if (isBlank(result.gateway())
                    || !"SABBPE".equalsIgnoreCase(
                            result.gateway().trim())) {

                throw new IllegalStateException(
                        "SabbPe returned an invalid gateway."
                );
            }

            // 8. Validate the product returned by SabbPe.
            if (isBlank(result.product())
                    || !"PAY_BY_LINK".equalsIgnoreCase(
                            result.product().trim())) {

                throw new IllegalStateException(
                        "SabbPe returned an invalid payment product."
                );
            }

            // 9. Validate the essential payment-status fields.
            if (isBlank(result.pblOrderRef())
                    || isBlank(result.merchantOrderRef())
                    || isBlank(result.paymentStatus())
                    || result.amount() == null) {

                throw new IllegalStateException(
                        "SabbPe returned an incomplete payment-status response."
                );
            }

            // Return the verified response to the callback controller.
            // Payment records are not updated by this service.
            return result;

        } catch (RestClientResponseException ex) {

            throw new IllegalStateException(
                    "SabbPe payment-status request failed with HTTP "
                            + ex.getStatusCode().value()
                            + ". Check the URL and merchant configuration.",
                    ex
            );
        }
    }

    private boolean isBlank(String value) {
        return value == null || value.isBlank();
    }

    @JsonIgnoreProperties(ignoreUnknown = true)
    public record SabbPePaymentStatusResponse(

            @JsonProperty("gateway")
            String gateway,

            @JsonProperty("product")
            String product,

            @JsonProperty("pbl_order_ref")
            String pblOrderRef,

            @JsonProperty("merchant_order_ref")
            String merchantOrderRef,

            @JsonProperty("master_transaction_id")
            String masterTransactionId,

            @JsonProperty("payment_status")
            String paymentStatus,

            @JsonProperty("link_status")
            String linkStatus,

            @JsonProperty("amount")
            BigDecimal amount,

            @JsonProperty("currency")
            String currency,

            @JsonProperty("payment_method")
            String paymentMethod,

            @JsonProperty("rrn")
            String rrn,

            @JsonProperty("payment_completed_at")
            String paymentCompletedAt

    ) {
    }
}