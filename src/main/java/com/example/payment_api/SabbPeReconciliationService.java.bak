package com.example.payment_api;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

@Service
public class SabbPeReconciliationService {

    private static final Logger logger =
            LoggerFactory.getLogger(SabbPeReconciliationService.class);

    private final PaymentRepository paymentRepository;
    private final PaymentSplitAllocationRepository allocationRepository;
    private final PaymentSplitService paymentSplitService;
    private final SabbPeStatusService sabbPeStatusService;

    public SabbPeReconciliationService(
            PaymentRepository paymentRepository,
            PaymentSplitAllocationRepository allocationRepository,
            PaymentSplitService paymentSplitService,
            SabbPeStatusService sabbPeStatusService) {

        this.paymentRepository = paymentRepository;
        this.allocationRepository = allocationRepository;
        this.paymentSplitService = paymentSplitService;
        this.sabbPeStatusService = sabbPeStatusService;
    }

    public Map<String, Object> reconcilePendingPayments() {

        List<Payment> pendingPayments =
                paymentRepository
                        .findByStatusIgnoreCaseAndPblOrderRefIsNotNull(
                                "PENDING"
                        );

        int checked = 0;
        int updated = 0;
        int unchanged = 0;
        int failed = 0;
        int allocationsSynchronized = 0;

        logger.info(
                "[SabbPe Reconciliation] Starting. Pending payments: {}",
                pendingPayments.size()
        );

        for (Payment payment : pendingPayments) {
            checked++;

            try {
                boolean changed = reconcilePayment(payment);

                if (changed) {
                    updated++;
                } else {
                    unchanged++;
                }

                if (synchronizeSplitAllocation(payment.getId())) {
                    allocationsSynchronized++;
                }

            } catch (RuntimeException ex) {
                failed++;

                logger.error(
                        "[SabbPe Reconciliation] Failed for payment ID {}: {}",
                        payment.getId(),
                        ex.getMessage(),
                        ex
                );
            }
        }

        /*
         * Also repair split allocations for payments that are already
         * SUCCESS in the database but whose allocations remain PENDING.
         *
         * This is needed because SUCCESS payments are not returned by
         * findByStatusIgnoreCaseAndPblOrderRefIsNotNull("PENDING").
         */
        for (PaymentSplitAllocation allocation :
                allocationRepository.findAll()) {

            if (allocation.getPaymentId() == null
                    || "SUCCESS".equalsIgnoreCase(allocation.getStatus())) {
                continue;
            }

            try {
                Payment linkedPayment = paymentRepository
                        .findById(allocation.getPaymentId())
                        .orElse(null);

                if (linkedPayment == null
                        || !"SUCCESS".equalsIgnoreCase(
                                linkedPayment.getStatus())) {
                    continue;
                }

                if (synchronizeSplitAllocation(linkedPayment.getId())) {
                    allocationsSynchronized++;
                }

            } catch (RuntimeException ex) {
                failed++;

                logger.error(
                        "[SabbPe Reconciliation] Failed to synchronize "
                                + "allocation ID {} for payment ID {}: {}",
                        allocation.getId(),
                        allocation.getPaymentId(),
                        ex.getMessage(),
                        ex
                );
            }
        }

        Map<String, Object> result = new LinkedHashMap<>();
        result.put("checked", checked);
        result.put("updated", updated);
        result.put("unchanged", unchanged);
        result.put("failed", failed);
        result.put("allocationsSynchronized", allocationsSynchronized);

        logger.info(
                "[SabbPe Reconciliation] Finished. checked={}, updated={}, "
                        + "unchanged={}, failed={}, allocationsSynchronized={}",
                checked,
                updated,
                unchanged,
                failed,
                allocationsSynchronized
        );

        return result;
    }

    @Transactional
    public boolean reconcilePayment(Payment payment) {

        if (payment == null
                || payment.getId() == null
                || isBlank(payment.getPblOrderRef())
                || isBlank(payment.getMerchantOrderRef())
                || payment.getAmount() == null
                || payment.getAmount() <= 0) {

            throw new IllegalArgumentException(
                    "Payment is missing required reconciliation fields."
            );
        }

        logger.info(
                "[SabbPe Reconciliation] Checking payment ID {}",
                payment.getId()
        );

        // Verify the payment status directly with SabbPe.
        SabbPeStatusService.SabbPePaymentStatusResponse response =
                sabbPeStatusService.getPaymentStatus(
                        payment.getPblOrderRef()
                );

        if (response == null
                || isBlank(response.pblOrderRef())
                || isBlank(response.merchantOrderRef())
                || isBlank(response.paymentStatus())
                || response.amount() == null) {

            throw new IllegalStateException(
                    "SabbPe returned an incomplete status response."
            );
        }

        logger.info(
                "[SabbPe Reconciliation] Payment ID: {}, Gateway Status: {}, "
                        + "Gateway Amount: {}, PBL Reference: {}, "
                        + "Merchant Reference: {}",
                payment.getId(),
                response.paymentStatus(),
                response.amount(),
                response.pblOrderRef(),
                response.merchantOrderRef()
        );

        // Verify that SabbPe returned the references for this payment.
        if (!payment.getPblOrderRef().trim()
                .equals(response.pblOrderRef().trim())
                || !payment.getMerchantOrderRef().trim()
                .equals(response.merchantOrderRef().trim())) {

            throw new IllegalStateException(
                    "SabbPe payment references do not match."
            );
        }

        BigDecimal storedAmount =
                BigDecimal.valueOf(payment.getAmount());

        if (storedAmount.compareTo(response.amount()) != 0) {
            throw new IllegalStateException(
                    "SabbPe payment amount does not match."
            );
        }

        String gatewayStatus =
                response.paymentStatus().trim()
                        .toUpperCase(Locale.ROOT);

        String currentStatus =
                payment.getStatus() == null
                        ? ""
                        : payment.getStatus().trim()
                                .toUpperCase(Locale.ROOT);

        // Never downgrade a payment already marked SUCCESS.
        if ("SUCCESS".equals(currentStatus)) {
            logger.info(
                    "[SabbPe Reconciliation] Payment ID {} is already SUCCESS.",
                    payment.getId()
            );

            return false;
        }

        switch (gatewayStatus) {

            case "SUCCESS":

                payment.setStatus("SUCCESS");

                if (!isBlank(response.masterTransactionId())) {
                    payment.setTransactionId(
                            response.masterTransactionId().trim()
                    );
                }

                paymentRepository.save(payment);

                logger.info(
                        "[SabbPe Reconciliation] Payment ID {} updated to SUCCESS.",
                        payment.getId()
                );

                return true;

            case "FAILED":
            case "CANCELLED":
            case "TIMEOUT":
            case "REFUNDED":

                payment.setStatus(gatewayStatus);
                paymentRepository.save(payment);

                logger.info(
                        "[SabbPe Reconciliation] Payment ID {} updated to {}.",
                        payment.getId(),
                        gatewayStatus
                );

                return true;

            case "PENDING":

                if (!"PENDING".equals(currentStatus)) {
                    payment.setStatus("PENDING");
                    paymentRepository.save(payment);

                    return true;
                }

                return false;

            default:
                throw new IllegalStateException(
                        "Unsupported SabbPe payment status: "
                                + gatewayStatus
                );
        }
    }

    /**
     * Synchronizes an allocation only when its linked payment is already
     * recorded as SUCCESS in the database.
     *
     * PaymentSplitService performs the existing amount and relationship
     * checks before marking the allocation as paid.
     */
    @Transactional
    public boolean synchronizeSplitAllocation(Long paymentId) {

        if (paymentId == null) {
            return false;
        }

        Payment payment = paymentRepository.findById(paymentId)
                .orElse(null);

        if (payment == null
                || !"SUCCESS".equalsIgnoreCase(payment.getStatus())) {
            return false;
        }

        PaymentSplitAllocation allocation =
                allocationRepository.findByPaymentId(paymentId)
                        .orElse(null);

        if (allocation == null) {
            // This may be an ordinary payment rather than a split payment.
            return false;
        }

        if ("SUCCESS".equalsIgnoreCase(allocation.getStatus())) {
            return false;
        }

        paymentSplitService.recordSuccessfulPayment(
                allocation.getSplitId(),
                allocation.getId(),
                paymentId
        );

        logger.info(
                "[SabbPe Reconciliation] Synchronized payment ID {} "
                        + "with allocation ID {} in split ID {}.",
                paymentId,
                allocation.getId(),
                allocation.getSplitId()
        );

        return true;
    }

    private boolean isBlank(String value) {
        return value == null || value.isBlank();
    }
}